<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0-windows;net11.0</TargetFrameworks>
    <IsWindowsTarget>$([System.Text.RegularExpressions.Regex]::IsMatch($(TargetFramework),'-windows'))</IsWindowsTarget>
    <OutputType>Exe</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <ApplicationIcon>..\Eto.Test\Images\TestIcon.ico</ApplicationIcon>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <UseWindowsForms>false</UseWindowsForms>
    <IsWindowsTarget>$([System.Text.RegularExpressions.Regex]::IsMatch($(TargetFramework),'-windows'))</IsWindowsTarget>
    <SelfContained>true</SelfContained>
    <Description>This is Eto.Platform.Windows (WinForms) ported to work with modern .net's Mono's port of System.Windows.Forms; should work natively on GNU/Linux (tested with Debian) and FreeBSD (untested but similar enough as much as the runtime is concerned). Works with libgdiplus. This uses ordinary WinForms on Microsoft Windows (R). Mono's SWF rewrite is arguably safer (more MANAGED code) and lighter (less resource intensive). This uses Cairo for drawing on non Microsoft Windows (R) platform.</Description>
    
  </PropertyGroup>

  <!-- If IsWindowsTarget is not set, default the runtime identifier to linux-x64 -->
  <!--<PropertyGroup Condition="'$(IsWindowsTarget)' != 'true'">
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <PublishSelfContained>true</PublishSelfContained>
  </PropertyGroup>-->

  <Target Name="AliasFrameworkDrawingReferences" AfterTargets="ResolveAssemblyReferences" BeforeTargets="CoreCompile">
    <ItemGroup>
      <!-- Alias the framework's System.Drawing.Primitives so it doesn't collide with your custom System.Drawing.dll -->
      <ReferencePath Condition="'%(FileName)' == 'System.Drawing.Primitives'">
        <Aliases>sysdrawing</Aliases>
      </ReferencePath>
      <!-- Also alias System.Drawing.Common just in case ConfigurationManager pulls it in -->
      <ReferencePath Condition="'%(FileName)' == 'System.Drawing.Common'">
        <Aliases>sysdrawingcommon</Aliases>
      </ReferencePath>
      <!--<ReferencePath Condition="'%(FileName)' == 'System.Windows.Forms'">
        <Aliases>syswinforms</Aliases>
      </ReferencePath>-->

    </ItemGroup>
  </Target>

  <PropertyGroup>
    <ApplicationManifest>Manifest-HiDpi.manifest</ApplicationManifest>
  </PropertyGroup>

  <Target Name="_RemoveWindowsDesktopTransitiveFrameworkReferences" BeforeTargets="_CheckForTransitiveWindowsDesktopDependencies" Condition="'$(IsWindowsTarget)' != 'true'">
    <ItemGroup>
      <TransitiveFrameworkReference Remove="Microsoft.WindowsDesktop.App" />
      <TransitiveFrameworkReference Remove="Microsoft.WindowsDesktop.App.WindowsForms" />
      <TransitiveFrameworkReference Remove="Microsoft.WindowsDesktop.App.WPF" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core.System.Windows.Forms\System.Windows.Forms\System.Windows.Forms.csproj" />
    <ProjectReference Include="..\..\src\Eto.WinForms\Eto.WinForms.csproj" />
    <ProjectReference Include="..\..\..\..\..\invnew\System.Drawing\System.Drawing.csproj" />
    <!--<PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.4" />
  	<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1938.49" PrivateAssets="all" />-->
    <PackageReference Include="System.Resources.Extensions" Version="7.0.0" />
  </ItemGroup>
  
  <ItemGroup>
    
    <Using Include="System.Drawing" Alias="sd" />
    <Using Include="System.Drawing.Imaging" Alias="sdi" />
    <Using Include="System.Drawing.Drawing2D" Alias="sd2" />
    <Using Include="System.Windows.Forms" Alias="swf" />
  </ItemGroup>

  

  <!-- (Optional) signal that you’re overriding the check -->
  <PropertyGroup>
    <OverrideInvalidWindowsDesktopTargeting>true</OverrideInvalidWindowsDesktopTargeting>
  </PropertyGroup>




  <ItemGroup>
    <Compile Include="..\..\src\Eto.WinForms\Win32.cs">
      <Link>Win32.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Eto\Eto.csproj" />
    <ProjectReference Include="..\..\src\Eto.WinForms\Eto.WinForms.csproj" />
    <ProjectReference Include="..\Eto.Test\Eto.Test.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="app.config" />
    <None Include="app.manifest" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.3.2" />
  </ItemGroup>
  <ItemGroup>
    <Service Include="{82A7F48D-3B50-4B1E-B82E-3ADA8210C358}" />
  </ItemGroup>
  <Target Name="_RemoveWindowsDesktopTransitiveFrameworkReferences" BeforeTargets="_CheckForTransitiveWindowsDesktopDependencies" Condition="'$(IsWindowsTarget)' != 'true'">
    <ItemGroup>
      <TransitiveFrameworkReference Remove="Microsoft.WindowsDesktop.App" />
      <TransitiveFrameworkReference Remove="Microsoft.WindowsDesktop.App.WindowsForms" />
      <TransitiveFrameworkReference Remove="Microsoft.WindowsDesktop.App.WPF" />
    </ItemGroup>
  </Target>

</Project>